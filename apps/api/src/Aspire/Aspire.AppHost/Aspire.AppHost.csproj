<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.2" />

  <PropertyGroup>
    <RootNamespace>Milese.Aspire.AppHost</RootNamespace>
    <AssemblyName>Milese.Aspire.AppHost</AssemblyName>

    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>milese-aspire-apphost</UserSecretsId>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Api\Api.Rest\Api.Rest.csproj" />
    <ProjectReference Include="..\Aspire.MigrationService\Aspire.MigrationService.csproj" />
  </ItemGroup>
</Project>
